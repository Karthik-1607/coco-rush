# Coco Rush — server environment
# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. These values are SERVER-ONLY: never inline them
# into index.html, app-config.js, or any file served to the browser.
# On Vercel add them under Project → Settings → Environment Variables.

# --- Razorpay ---------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# The key id is duplicated into app-config.js (it is public by design).
# The *secret* stays here and nowhere else.

# --- Firebase Admin ---------------------------------------------------------
# Full service-account JSON, minified onto ONE line.
# Firebase Console → Project Settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","token_uri":"https://oauth2.googleapis.com/token"}

# Realtime Database URL, e.g. https://your-project-default-rtdb.firebaseio.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# --- Optional ---------------------------------------------------------------
# Comma-separated origins allowed to call the API. Empty = same-origin only.
ALLOWED_ORIGINS=
